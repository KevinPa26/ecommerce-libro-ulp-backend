
@model ecommerce_libro_ulp_backend.Models.Libro

@{
    ViewData["Title"] = "Editar Libro";
}

<div id="app" class="container mt-4 mb-5">

    <!-- Breadcrumb y Título -->
    <div class="mb-4">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                <li class="breadcrumb-item">
                    <a asp-action="Index">Libros</a>
                </li>
                <li class="breadcrumb-item active" aria-current="page">
                    Editar Libro
                </li>
            </ol>
        </nav>

        <h2 class="fw-bold text-primary">
            <i class="bi bi-pencil-square"></i> Editar Información del Libro
        </h2>
    </div>

    <div class="row">
        <div class="col-md-10 mx-auto">
            <div class="card shadow-sm">

                <div class="card-header bg-primary text-white py-3">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-book"></i> Formulario de Edición
                    </h5>
                </div>

                <div class="card-body p-4">

                    <!-- Notificaciones -->
                    <div v-if="notificacion.mensaje"
                         class="alert mb-3"
                         :class="'alert-' + notificacion.tipo"
                         role="alert">
                        {{ notificacion.mensaje }}
                    </div>

                    <!-- Formulario -->
                    <form asp-action="Editar"
                          method="post"
                          enctype="multipart/form-data"
                          ref="formulario"
                          @@submit.prevent="guardarCambios">

                        @Html.AntiForgeryToken()

                        <!-- Campo oculto para el ID -->
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="VendedorId" />

                        <!-- IDs de imágenes a eliminar -->
                        <input type="hidden"
                               v-for="id in imagenesAEliminar"
                               name="imagenesAEliminar"
                               :value="id"
                               :key="id" />

                        <div class="row g-3">

                            <!-- ISBN (INMUTABLE) -->
                            <div class="col-md-6">
                                <label asp-for="Isbn13" class="form-label fw-bold">
                                    ISBN-13
                                    <span class="text-muted fw-normal small">
                                        (No modificable)
                                    </span>
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-upc-scan text-muted"></i>
                                    </span>
                                    <input asp-for="Isbn13"
                                           class="form-control bg-light"
                                           readonly />
                                </div>
                            </div>

                            <!-- Título (INMUTABLE) -->
                            <div class="col-md-6">
                                <label asp-for="Titulo" class="form-label fw-bold">
                                    Título del Libro
                                    <span class="text-muted fw-normal small">
                                        (No modificable)
                                    </span>
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-type text-muted"></i>
                                    </span>
                                    <input asp-for="Titulo"
                                           class="form-control bg-light"
                                           readonly />
                                </div>
                            </div>

                            <!-- Autor (INMUTABLE) -->
                            <div class="col-md-12">
                                <label asp-for="Autor" class="form-label fw-bold">
                                    Autor
                                    <span class="text-muted fw-normal small">
                                        (No modificable)
                                    </span>
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text bg-light">
                                        <i class="bi bi-pen text-muted"></i>
                                    </span>
                                    <input asp-for="Autor"
                                           class="form-control bg-light"
                                           readonly />
                                </div>
                            </div>

                            <!-- Precio -->
                            <div class="col-md-4">
                                <label asp-for="Precio" class="form-label fw-bold">
                                    Precio ($) *
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-currency-dollar"></i>
                                    </span>
                                    <input asp-for="Precio"
                                           type="number"
                                           step="0.01"
                                           min="0.01"
                                           v-model.number="form.precio"
                                           class="form-control"
                                           required />
                                </div>

                                <span asp-validation-for="Precio"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Stock -->
                            <div class="col-md-4">
                                <label asp-for="Stock" class="form-label fw-bold">
                                    Stock Actual *
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-boxes"></i>
                                    </span>
                                    <input asp-for="Stock"
                                           type="number"
                                           min="1"
                                           v-model.number="form.stock"
                                           class="form-control"
                                           required />
                                </div>

                                <span asp-validation-for="Stock"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Estado -->
                            <div class="col-md-4">
                                <label asp-for="Estado" class="form-label fw-bold">
                                    Estado *
                                </label>

                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="bi bi-toggle-on"></i>
                                    </span>
                                    <select asp-for="Estado"
                                            v-model="form.estado"
                                            class="form-select"
                                            asp-items="Html.GetEnumSelectList<ecommerce_libro_ulp_backend.Models.EstadoLibro>()">
                                    </select>
                                </div>

                                <span asp-validation-for="Estado"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Imágenes actuales -->
                            <div class="col-12 mt-4"
                                 v-if="imagenesActuales.length > 0">

                                <label class="form-label fw-bold text-secondary">
                                    <i class="bi bi-images text-primary"></i>
                                    Imágenes Actuales en el Catálogo
                                </label>

                                <div class="d-flex flex-wrap gap-3">

                                    <div v-for="img in imagenesActuales"
                                         :key="img.id"
                                         class="position-relative border rounded p-1 shadow-sm bg-light"
                                         style="width: 110px; height: 110px;">

                                        <img :src="img.path"
                                             class="w-100 h-100 object-fit-cover rounded" />

                                        <span v-if="img.esPrincipal"
                                              class="position-absolute bottom-0 start-0 badge bg-success m-1 small"
                                              style="font-size: 0.65rem;">
                                            Principal
                                        </span>

                                        <button type="button"
                                                class="btn btn-danger btn-sm position-absolute top-0 start-100 translate-middle rounded-circle p-0 d-flex justify-content-center align-items-center shadow"
                                                style="width: 26px; height: 26px;"
                                                @@click="eliminarImagenActual(img.id)"
                                                title="Eliminar imagen">
                                            <i class="bi bi-x fs-6"></i>
                                        </button>

                                    </div>
                                </div>

                                <small class="text-muted d-block mt-1">
                                    Puedes eliminar las fotos que ya no desees
                                    conservando al menos una.
                                </small>
                            </div>

                            <!-- Nuevas fotografías -->
                            <div class="col-12 mt-3">
                                <label for="archivosFotos"
                                       class="form-label fw-bold">
                                    <i class="bi bi-plus-circle text-primary"></i>
                                    Agregar Nuevas Fotografías
                                </label>

                                <div class="input-group">
                                    <input type="file"
                                           id="archivosFotos"
                                           name="archivosFotos"
                                           class="form-control"
                                           accept=".jpg, .jpeg, .png, .webp"
                                           multiple
                                           @@change="onFilesChange" />
                                </div>
                            </div>

                            <!-- Vista previa de nuevas imágenes -->
                            <div class="col-12" v-if="previews.length > 0">

                                <label class="form-label small text-secondary fw-semibold d-block">
                                    Vista previa de nuevas imágenes:
                                </label>

                                <div class="d-flex flex-wrap gap-3">

                                    <div v-for="(img, index) in previews"
                                         :key="index"
                                         class="position-relative border rounded p-1 shadow-sm bg-light"
                                         style="width: 110px; height: 110px;">

                                        <img :src="img"
                                             class="w-100 h-100 object-fit-cover rounded" />

                                        <button type="button"
                                                class="btn btn-danger btn-sm position-absolute top-0 start-100 translate-middle rounded-circle p-0 d-flex justify-content-center align-items-center shadow"
                                                style="width: 26px; height: 26px;"
                                                @@click="removerImagenNueva(index)"
                                                title="Quitar imagen nueva">
                                            <i class="bi bi-x fs-6"></i>
                                        </button>

                                    </div>
                                </div>
                            </div>

                            <!-- Descripción del vendedor -->
                            <div class="col-12 mt-3">
                                <label asp-for="DescripcionVendedor"
                                       class="form-label fw-bold">
                                    Descripción del Vendedor
                                    (Estado del libro, detalles de uso)
                                </label>

                                <textarea asp-for="DescripcionVendedor"
                                          v-model="form.descripcionVendedor"
                                          class="form-control"
                                          rows="3"></textarea>

                                <span asp-validation-for="DescripcionVendedor"
                                      class="text-danger small"></span>
                            </div>

                            <!-- Descripción general -->
                            <div class="col-12">
                                <label asp-for="DescripcionLibro"
                                       class="form-label fw-bold">
                                    Sinopsis / Descripción General del Libro
                                </label>

                                <textarea asp-for="DescripcionLibro"
                                          v-model="form.descripcionLibro"
                                          class="form-control"
                                          rows="3"></textarea>

                                <span asp-validation-for="DescripcionLibro"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <hr class="my-4" />

                        <!-- Botones -->
                        <div class="d-flex justify-content-between align-items-center">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i>
                                Volver al Listado
                            </a>

                            <button type="submit"
                                    class="btn btn-primary px-4"
                                    :disabled="guardando">

                                <span v-if="guardando">
                                    <span class="spinner-border spinner-border-sm me-1"></span>
                                    Guardando...
                                </span>

                                <span v-else>
                                    <i class="bi bi-check-circle"></i>
                                    Guardar Cambios
                                </span>

                            </button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    const { createApp } = Vue;

    createApp({
        data() {
            return {
                imagenesIniciales: @Html.Raw(
                    System.Text.Json.JsonSerializer.Serialize(
                        Model.Imagenes?.Select(img => new
                        {
                            id = img.Id,
                            path = img.Path,
                            esPrincipal = img.EsPrincipal
                        }),
                        new System.Text.Json.JsonSerializerOptions(
                            System.Text.Json.JsonSerializerDefaults.Web
                        )
                    )
                ),

                imagenesActuales: [],
                imagenesAEliminar: [],

                form: {
                    precio: @Model.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture),
                    stock: @Model.Stock,
                    estado: '@((int)Model.Estado)',
                    descripcionVendedor: @Json.Serialize(Model.DescripcionVendedor ?? ""),
                    descripcionLibro: @Json.Serialize(Model.DescripcionLibro ?? "")
                },

                archivosSeleccionados: [],
                previews: [],

                guardando: false,

                notificacion: {
                    mensaje: '',
                    tipo: 'info'
                }
            };
        },

        mounted() {
            this.imagenesActuales = this.imagenesIniciales || [];
        },

        methods: {
            mostrarNotificacion(mensaje, tipo = 'info') {
                this.notificacion = { mensaje, tipo };

                window.scrollTo({
                    top: 0,
                    behavior: 'smooth'
                });
            },

            eliminarImagenActual(id) {
                if (!this.imagenesAEliminar.includes(id)) {
                    this.imagenesAEliminar.push(id);
                }

                this.imagenesActuales = this.imagenesActuales.filter(
                    img => img.id !== id
                );
            },

            onFilesChange(e) {
                const files = Array.from(e.target.files);

                const totalImagenesRestantes =
                    this.imagenesActuales.length + files.length;

                if (totalImagenesRestantes > 4) {
                    this.mostrarNotificacion(
                        'El libro no puede tener más de 4 imágenes en total.',
                        'warning'
                    );

                    e.target.value = '';
                    this.archivosSeleccionados = [];
                    this.previews = [];
                    return;
                }

                this.archivosSeleccionados = files;

                // Reservamos las posiciones para respetar el orden seleccionado.
                this.previews = files.map(() => '');

                files.forEach((file, index) => {
                    const reader = new FileReader();

                    reader.onload = (evt) => {
                        this.previews[index] = evt.target.result;
                    };

                    reader.readAsDataURL(file);
                });
            },

            removerImagenNueva(index) {
                this.archivosSeleccionados.splice(index, 1);
                this.previews.splice(index, 1);

                const input = document.getElementById('archivosFotos');
                const dataTransfer = new DataTransfer();

                this.archivosSeleccionados.forEach(file => {
                    dataTransfer.items.add(file);
                });

                input.files = dataTransfer.files;

                if (this.archivosSeleccionados.length === 0) {
                    input.value = '';
                }
            },

            validarFormulario() {
                if (!this.form.precio || this.form.precio <= 0) {
                    this.mostrarNotificacion(
                        'Por favor ingrese un precio válido.',
                        'warning'
                    );
                    return false;
                }

                if (this.form.stock < 1) {
                    this.mostrarNotificacion(
                        'El stock debe ser como mínimo 1.',
                        'warning'
                    );
                    return false;
                }

                const totalFinal =
                    this.imagenesActuales.length +
                    this.archivosSeleccionados.length;

                if (totalFinal === 0) {
                    this.mostrarNotificacion(
                        'El libro debe tener al menos 1 imagen.',
                        'warning'
                    );
                    return false;
                }

                if (totalFinal > 4) {
                    this.mostrarNotificacion(
                        'El libro no puede tener más de 4 imágenes.',
                        'warning'
                    );
                    return false;
                }

                return true;
            },

            async guardarCambios() {
                if (this.guardando) return;

                if (!this.validarFormulario()) return;

                const formulario = this.$refs.formulario;
                const formData = new FormData(formulario);

                this.guardando = true;
                this.notificacion.mensaje = '';

                try {
                    const response = await fetch(formulario.action, {
                        method: 'POST',
                        body: formData,
                        credentials: 'same-origin',
                        headers: {
                            'Accept': 'application/json'
                        }
                    });

                    const data = await response.json();

                    if (!response.ok || !data.success) {
                        throw new Error(
                            data.message || 'No se pudieron guardar los cambios.'
                        );
                    }

                    this.mostrarNotificacion(
                        data.message || 'Los cambios se guardaron correctamente.',
                        'success'
                    );

                    // Actualizamos el listado de imágenes con la respuesta
                    // cuando el backend la incluya.
                    if (data.imagenes) {
                        this.imagenesActuales = data.imagenes;
                        this.imagenesAEliminar = [];
                    }

                    this.archivosSeleccionados = [];
                    this.previews = [];

                    document.getElementById('archivosFotos').value = '';

                } catch (error) {
                    this.mostrarNotificacion(
                        error.message || 'Ocurrió un error al guardar los cambios.',
                        'danger'
                    );
                } finally {
                    this.guardando = false;
                }
            }
        }
    }).mount('#app');
</script>
