@model IEnumerable<ecommerce_libro_ulp_backend.Models.Libro>

@{
    ViewData["Title"] = "Catálogo de Libros";
}

<div id="app" class="container mt-4 mb-5">
    <!-- Encabezado y Botón de Creación -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Catálogo</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-primary">
                <i class="bi bi-grid-fill"></i> Catálogo de Libros
            </h2>
        </div>
        <a asp-action="Crear" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-circle"></i> Nuevo Libro
        </a>
    </div>

    <!-- Barra de Búsqueda Estilo Buscador -->
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light rounded">
            <div class="row align-items-center">
                <div class="col-md-12">
                    <div class="input-group input-group-lg">
                        <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                        <input type="text" 
                               v-model="busqueda" 
                               class="form-control" 
                               placeholder="Buscar por título, autor o ISBN..." />
                        <button v-if="busqueda" @@click="busqueda = ''" class="btn btn-outline-secondary" type="button">
                            <i class="bi bi-x-lg"></i> Limpiar
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Mensaje si no hay resultados -->
    <div v-if="librosFiltrados.length === 0" class="text-center py-5">
        <i class="bi bi-search fs-1 text-muted d-block mb-3"></i>
        <h4 class="text-secondary">No se encontraron libros</h4>
        <p class="text-muted">Intenta realizar otra búsqueda con términos diferentes.</p>
    </div>

    <!-- Grilla de Productos (Estilo MercadoLibre / Tarjetas) -->
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        <div class="col" v-for="libro in librosPaginados" :key="libro.Id">
            <div class="card h-100 shadow-sm border-0 position-relative hover-card">
                
                <!-- Badge de Estado en la esquina superior -->
                <div class="position-absolute top-0 end-0 m-2 z-index-1">
                    <span v-if="libro.Estado === 0" class="badge bg-success shadow-sm">Disponible</span>
                    <span v-else-if="libro.Estado === 1" class="badge bg-warning text-dark shadow-sm">Agotado</span>
                    <span v-else class="badge bg-danger shadow-sm">Inactivo</span>
                </div>

                <!-- Imagen del Libro (Portada Principal o placeholder por defecto) -->
                <div class="bg-light text-center overflow-hidden position-relative" style="height: 220px;">
                    <img :src="obtenerImagenPrincipal(libro)" 
                         class="w-100 h-100 object-fit-contain p-2" 
                         alt="Portada del libro" 
                         onerror="this.src='https://via.placeholder.com/150?text=Sin+Imagen'" />
                </div>

                <!-- Cuerpo de la Tarjeta (Información) -->
                <div class="card-body d-flex flex-column">
                    <!-- Título -->
                    <h5 class="card-title fw-bold text-dark text-truncate mb-1" :title="libro.Titulo">
                        {{ libro.Titulo }}
                    </h5>
                    <!-- Autor -->
                    <p class="card-subtitle text-muted small mb-2 text-truncate">
                        <i class="bi bi-pen"></i> {{ libro.Autor }}
                    </p>

                    <!-- ISBN si existe -->
                    <small class="text-muted mb-2" v-if="libro.Isbn13">
                        <span class="badge bg-light text-dark border">ISBN: {{ libro.Isbn13 }}</span>
                    </small>

                    <!-- Precio -->
                    <div class="mt-auto">
                        <div class="fs-4 fw-bold text-success mb-1">
                            $ {{ libro.Precio.toLocaleString('es-AR', { minimumFractionDigits: 2 }) }}
                        </div>
                        
                        <!-- Stock -->
                        <div class="small mb-3">
                            <span :class="libro.Stock > 0 ? 'text-info fw-semibold' : 'text-muted'">
                                <i class="bi bi-boxes"></i> {{ libro.Stock }} disponibles
                            </span>
                        </div>
                    </div>

                    <!-- Botones de Acción (Detalles, Editar, Eliminar) -->
                    <div class="btn-group w-100" role="group">
                        <a :href="'/Libros/Details/' + libro.Id" class="btn btn-outline-info btn-sm" title="Ver Detalles">
                            <i class="bi bi-eye"></i> Ver
                        </a>
                        <a :href="'/Libros/Editar/' + libro.Id" class="btn btn-outline-primary btn-sm" title="Editar">
                            <i class="bi bi-pencil-square"></i> Editar
                        </a>
                        <a :href="'/Libros/Eliminar/' + libro.Id" class="btn btn-outline-danger btn-sm" title="Dar de baja">
                            <i class="bi bi-trash"></i> Baja
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Paginación Footer -->
    <div class="card bg-white shadow-sm mt-4 p-3 d-flex flex-row justify-content-between align-items-center" v-if="totalPaginas > 1">
        <span class="text-muted small">
            Mostrando página <strong>{{ currentPage }}</strong> de {{ totalPaginas }} ({{ librosFiltrados.length }} libros en total)
        </span>
        <nav aria-label="Paginación de libros">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item" :class="{ disabled: currentPage === 1 }">
                    <button class="page-link" @@click="cambiarPagina(currentPage - 1)">Anterior</button>
                </li>
                <li v-for="page in totalPaginas" :key="page" class="page-item" :class="{ active: page === currentPage }">
                    <button class="page-link" @@click="cambiarPagina(page)">{{ page }}</button>
                </li>
                <li class="page-item" :class="{ disabled: currentPage === totalPaginas }">
                    <button class="page-link" @@click="cambiarPagina(currentPage + 1)">Siguiente</button>
                </li>
            </ul>
        </nav>
    </div>
</div>

<!-- Estilos adicionales para mejorar la estética de las tarjetas -->
<style>
    .hover-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 .5rem 1rem rgba(0,0,0,.15)!important;
    }
</style>

<!-- Script de Vue 3 (Options API) -->
<script>
    const { createApp } = Vue;

    createApp({
        data() {
            return {
                libros: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model)),
                busqueda: '',
                currentPage: 1,
                pageSize: 8 // Mostramos 8 tarjetas por página (múltiplo de 4 para la grilla)
            }
        },
        computed: {
            librosFiltrados() {
                if (!this.busqueda) return this.libros;
                const termino = this.busqueda.toLowerCase();
                return this.libros.filter(l => 
                    (l.Titulo && l.Titulo.toLowerCase().includes(termino)) ||
                    (l.Autor && l.Autor.toLowerCase().includes(termino)) ||
                    (l.Isbn13 && l.Isbn13.includes(termino))
                );
            },
            totalPaginas() {
                return Math.ceil(this.librosFiltrados.length / this.pageSize) || 1;
            },
            librosPaginados() {
                const inicio = (this.currentPage - 1) * this.pageSize;
                const fin = inicio + this.pageSize;
                return this.librosFiltrados.slice(inicio, fin);
            }
        },
        watch: {
            busqueda() {
                this.currentPage = 1;
            }
        },
        methods: {
            cambiarPagina(pagina) {
                if (pagina >= 1 && pagina <= this.totalPaginas) {
                    this.currentPage = pagina;
                }
            },
            obtenerImagenPrincipal(libro) {
                // Si tu modelo incluye la lista de imágenes asociadas, buscamos la que tenga EsPrincipal == true
                if (libro.Imagenes && libro.Imagenes.length > 0) {
                    const principal = libro.Imagenes.find(img => img.EsPrincipal);
                    return principal ? principal.Path : libro.Imagenes[0].Path;
                }
                // Si no hay imágenes cargadas en el objeto, puedes retornar un placeholder
                return 'https://via.placeholder.com/150?text=Sin+Portada';
            }
        }
    }).mount('#app');
</script>