@model IEnumerable<ecommerce_libro_ulp_backend.Models.Favorito>

@{
	ViewData["Title"] = "Mis favoritos";
}

<div class="container py-4">
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
		<div>
			<h1 class="h2 mb-1">Mis favoritos</h1>
			<p class="text-muted mb-0">Libros que guardaste para consultar más tarde.</p>
		</div>
		<span class="badge rounded-pill text-bg-secondary">@(Model?.Count() ?? 0) libros</span>
	</div>

	@if (Model == null || !Model.Any())
	{
		<div class="border rounded p-4 p-md-5 text-center">
			<i class="bi bi-heart text-danger fs-1" aria-hidden="true"></i>
			<h2 class="h5 mt-3">Todavía no tienes favoritos</h2>
			<p class="text-muted mb-0">Los libros que guardes aparecerán aquí.</p>
		</div>
	}
	else
	{
		<div class="table-responsive border rounded">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th scope="col">Libro</th>
						<th scope="col">Agregado</th>
						<th scope="col" class="text-end">Acciones</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var favorito in Model)
					{
						@if (favorito.Libro != null) // Si el libro no se encuentra, no lo mostramos en la lista
						{
							<tr>
								<td class="fw-semibold">@favorito.Libro.Titulo</td>
								<td>
									@if (favorito.FechaAgregado.HasValue)
									{
										@favorito.FechaAgregado.Value.ToString("dd/MM/yyyy")
									}
									else
									{
										<span class="text-muted">Sin fecha</span>
									}
								</td>
								<td class="text-end">
									<button type="button" class="btn btn-sm btn-outline-danger" aria-label="Quitar @favorito.Libro.Titulo de favoritos">
										<i class="bi bi-trash3 me-1" aria-hidden="true"></i>Quitar
									</button>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>
	}
</div>
