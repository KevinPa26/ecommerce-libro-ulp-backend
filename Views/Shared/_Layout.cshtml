
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ecommerce_libro_ulp_backend</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ecommerce_libro_ulp_backend.styles.css" asp-append-version="true" />

    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>

    <style>
        .main-navbar {
            background: linear-gradient(110deg, #171923, #252b3a);
            border-bottom: 1px solid rgba(255, 255, 255, .09);
            box-shadow: 0 4px 18px rgba(0, 0, 0, .12);
        }

        .main-navbar .navbar-brand {
            color: #fff;
            font-weight: 700;
            letter-spacing: -.4px;
        }

        .main-navbar .navbar-brand i {
            color: #8b9cff;
        }

        .main-navbar .nav-link {
            color: #cbd0dc;
            padding: .6rem .85rem;
            border-radius: .55rem;
            transition: background-color .2s, color .2s;
        }

        .main-navbar .nav-link:hover,
        .main-navbar .nav-link:focus {
            color: #fff;
            background: rgba(255, 255, 255, .09);
        }

        .main-navbar .nav-link i {
            margin-right: .35rem;
        }

        .main-navbar .navbar-toggler {
            border-color: rgba(255, 255, 255, .25);
        }

        .main-navbar .navbar-toggler-icon {
            filter: invert(1);
        }

        .nav-action {
            border: 1px solid rgba(255, 255, 255, .2);
            border-radius: .55rem;
            padding: .5rem .85rem !important;
        }

        .nav-register {
            background: #6678e8;
            color: #fff !important;
            border-radius: .55rem;
            padding: .5rem .85rem !important;
        }

        .nav-register:hover {
            background: #5365d2 !important;
        }

        .nav-admin {
            color: #f5d58a !important;
        }

        .nav-admin:hover {
            background: rgba(245, 213, 138, .12) !important;
        }

        /* Accesos compactos: carrito y favoritos */
        .nav-icon-action {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 38px;
            height: 38px;
            padding: 0 !important;
            border: 1px solid rgba(255, 255, 255, .16);
            border-radius: 10px;
            color: #cbd0dc;
            transition: all .2s ease;
        }

        .nav-icon-action i {
            margin: 0 !important;
            font-size: 1.15rem;
        }

        .nav-cart:hover {
            color: #67e8f9 !important;
            border-color: rgba(103, 232, 249, .65);
            box-shadow: 0 0 12px rgba(103, 232, 249, .18);
        }

        .nav-favorites:hover {
            color: #fb7185 !important;
            border-color: rgba(251, 113, 133, .65);
            box-shadow: 0 0 12px rgba(251, 113, 133, .18);
        }

        /* Botón desplegable de perfil */
        .profile-dropdown .dropdown-toggle {
            display: inline-flex;
            align-items: center;
            gap: .45rem;
            padding: .4rem .7rem !important;
            border: 1px solid rgba(139, 156, 255, .35);
            border-radius: 9px;
            color: #e2e6ff;
            font-size: .875rem;
            transition: all .2s ease;
        }

        .profile-dropdown .dropdown-toggle:hover,
        .profile-dropdown .dropdown-toggle:focus {
            color: #fff;
            border-color: #8b9cff;
            background: rgba(139, 156, 255, .12);
            box-shadow: 0 0 12px rgba(139, 156, 255, .12);
        }

        .profile-dropdown .dropdown-toggle::after {
            margin-left: .15rem;
        }

        .profile-dropdown .dropdown-menu {
            min-width: 205px;
            margin-top: .65rem;
            padding: .45rem;
            background: #171923;
            border: 1px solid rgba(255, 255, 255, .12);
            border-radius: 12px;
            box-shadow: 0 12px 35px rgba(0, 0, 0, .35);
        }

        .profile-dropdown .dropdown-item {
            padding: .65rem .75rem;
            color: #cbd0dc;
            border-radius: 7px;
            font-size: .9rem;
            transition: all .2s ease;
        }

        .profile-dropdown .dropdown-item i {
            margin-right: .5rem;
        }

        .profile-dropdown .dropdown-item:hover,
        .profile-dropdown .dropdown-item:focus {
            color: #fff;
            background: rgba(255, 255, 255, .08);
        }

        /* Cerrar sesión: rojo neón */
        .profile-dropdown .dropdown-item.logout-neon {
            color: #ff647c;
            border: 1px solid transparent;
            background: rgba(255, 45, 85, .055);
        }

        .profile-dropdown .dropdown-item.logout-neon:hover,
        .profile-dropdown .dropdown-item.logout-neon:focus {
            color: #fff;
            background: rgba(255, 45, 85, .16);
            border-color: rgba(255, 65, 100, .7);
            box-shadow:
                0 0 8px rgba(255, 45, 85, .2),
                inset 0 0 8px rgba(255, 45, 85, .05);
            text-shadow: 0 0 8px rgba(255, 65, 100, .65);
        }

        .profile-dropdown .dropdown-divider {
            border-top-color: rgba(255, 255, 255, .12);
        }

    </style>
</head>

<body class="d-flex flex-column min-vh-100">
    @{
        bool IsAuthenticated = User?.Identity?.IsAuthenticated ?? false;
        var NombreUsuario = User?.Identity?.Name
            ?? User?.Claims.FirstOrDefault(c => c.Type == "Name")?.Value
            ?? "";

        var IsAdmin = User?.IsInRole("ADMIN") ?? false;
        var IsUsuario = User?.IsInRole("USUARIO") ?? false;
    }
    <header>
        <nav class="navbar navbar-expand-lg main-navbar mb-4">
            <div class="container">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-book-half me-2"></i>
                    Ecommerce Libro
                </a>

                <button class="navbar-toggler" type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarPrincipal"
                        aria-controls="navbarPrincipal"
                        aria-expanded="false"
                        aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarPrincipal">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a asp-controller="Libros" asp-action="Index" class="nav-link">
                                <i class="bi bi-house-door me-1"></i>
                                Inicio
                            </a>
                        </li>

                        @if (IsAuthenticated && IsAdmin)
                        {
                            <li class="nav-item" id="navUsuarios">
                                <a class="nav-link nav-admin"
                                asp-controller="Usuarios"
                                asp-action="Index">
                                    <i class="bi bi-shield-lock"></i>Usuarios
                                </a>
                            </li>
                        }

                        @if (IsAuthenticated && IsUsuario)
                        {
                            <li class="nav-item" id="itemCompras">
                                <a class="nav-link"
                                asp-controller="Compras"
                                asp-action="Index">
                                    <i class="bi bi-bag-check"></i>Compras
                                </a>
                            </li>
                        }


                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Privacy">
                                <i class="bi bi-shield-check"></i>Privacidad
                            </a>
                        </li>
                    </ul>

                    
                    <ul class="navbar-nav align-items-lg-center gap-2">

                        @if (IsAuthenticated && IsUsuario)
                        {
                            <li class="nav-item" id="itemCarrito">
                                <a class="nav-link nav-icon-action nav-cart"
                                asp-controller="Carritos"
                                asp-action="Index"
                                aria-label="Mi carrito"
                                title="Mi carrito">
                                    <i class="bi bi-cart3"></i>
                                </a>
                            </li>

                            <li class="nav-item" id="itemFavoritos">
                                <a class="nav-link nav-icon-action nav-favorites"
                                asp-controller="Favoritos"
                                asp-action="Index"
                                aria-label="Mis favoritos"
                                title="Mis favoritos">
                                    <i class="bi bi-heart"></i>
                                </a>
                            </li>
                        }

                        @if (IsAuthenticated)
                        {
                            <li class="nav-item dropdown profile-dropdown">
                                <button class="nav-link dropdown-toggle"
                                        type="button"
                                        id="menuPerfil"
                                        data-bs-toggle="dropdown"
                                        aria-expanded="false">
                                    <i class="bi bi-person-circle"></i>
                                </button>

                                <ul class="dropdown-menu dropdown-menu-end"
                                    aria-labelledby="menuPerfil">

                                    <li>
                                        <a class="dropdown-item"
                                        asp-controller="Auth"
                                        asp-action="Perfil"
                                        id="navPerfil">
                                            <i class="bi bi-person"></i>
                                            Ver mi perfil
                                        </a>
                                    </li>

                                    <li>
                                        <hr class="dropdown-divider" />
                                    </li>

                                    <li>
                                        <button class="dropdown-item logout-neon"
                                                type="button"
                                                id="navLogout">
                                            <i class="bi bi-box-arrow-right"></i>
                                            Cerrar sesión
                                        </button>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item" id="itemLogin">
                                <a class="nav-link nav-action"
                                asp-controller="Auth"
                                asp-action="Login"
                                id="navLogin">
                                    <i class="bi bi-box-arrow-in-right"></i>
                                    Iniciar sesión
                                </a>
                            </li>

                            <li class="nav-item" id="itemRegistro">
                                <a class="nav-link nav-register"
                                asp-controller="Auth"
                                asp-action="Registro"
                                id="navRegistro">
                                    <i class="bi bi-person-plus"></i>
                                    Crear cuenta
                                </a>
                            </li>
                        }

                    </ul>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="container flex-grow-1 pb-4">
        @RenderBody()
    </main>

    
    <footer class="mt-auto py-4 bg-dark text-light">
        <div class="container">
            <div class="row align-items-center gy-3">

                <div class="col-md-6 text-center text-md-start">
                    <a asp-controller="Libros"
                    asp-action="Index"
                    class="text-decoration-none fw-bold text-white">
                        <i class="bi bi-book-half text-primary me-2"></i>
                        Librería ULP
                    </a>

                    <p class="text-white-50 small mb-0 mt-1">
                        Un espacio para descubrir tu próxima lectura.
                    </p>
                </div>

                <div class="col-md-6 text-center text-md-end">
                    <a asp-controller="Home"
                    asp-action="Privacy"
                    class="text-decoration-none text-white-50 small">
                        <i class="bi bi-shield-check me-1"></i>
                        Privacidad
                    </a>

                    <span class="text-white-50 mx-2">·</span>

                    <span class="text-white-50 small">
                        © 2026 Librería ULP
                    </span>
                </div>

            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        
    (() => {
        const login = document.getElementById("itemLogin");
        const registro = document.getElementById("itemRegistro");
        const perfil = document.getElementById("itemPerfil");
        const logout = document.getElementById("itemLogout");
        const usuarios = document.getElementById("navUsuarios");
        const compras = document.getElementById("itemCompras");
        const carrito = document.getElementById("itemCarrito");
        const favoritos = document.getElementById("itemFavoritos");

        function mostrarAutenticado(autenticado) {
            login?.classList.toggle("d-none", autenticado);
            registro?.classList.toggle("d-none", autenticado);
            perfil?.classList.toggle("d-none", !autenticado);
            logout?.classList.toggle("d-none", !autenticado);
        }

        function mostrarRol(rol) {
            const rolNormalizado = String(rol ?? "").trim().toUpperCase();
            const esAdmin = rolNormalizado === "ADMIN";
            const esUsuario = rolNormalizado === "USUARIO";

            usuarios?.classList.toggle("d-none", !esAdmin);
            compras?.classList.toggle("d-none", !esUsuario);
            carrito?.classList.toggle("d-none", !esUsuario);
            favoritos?.classList.toggle("d-none", !esUsuario);
        }

        async function actualizarMenu() {
            mostrarAutenticado(false);
            mostrarRol("");

            try {
                const response = await fetch("/api/account/me", {
                    method: "GET",
                    credentials: "same-origin",
                    headers: {
                        "Accept": "application/json"
                    }
                });

                if (!response.ok) {
                    return;
                }

                const data = await response.json();
                const usuario = data.usuario ?? data.Usuario ?? data;

                const rol = usuario.rol ?? usuario.Rol ?? "";

                mostrarAutenticado(true);
                mostrarRol(rol);

            } catch (error) {
                console.error(
                    "Error al consultar la sesión:",
                    error
                );
            }
        }

        document.getElementById("navLogout")
            ?.addEventListener("click", async () => {
                try {
                    const response = await fetch("/api/account/logout", {
                        method: "POST",
                        credentials: "same-origin"
                    });

                    if (!response.ok) {
                        console.error("No se pudo cerrar la sesión.");
                        return;
                    }

                    sessionStorage.removeItem("jwt");

                    mostrarAutenticado(false);
                    mostrarRol("");

                    window.location.replace("/Auth/Login");

                } catch (error) {
                    console.error(
                        "Error al cerrar sesión:",
                        error
                    );
                }
            });

        actualizarMenu();
    })();

    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

