@model IEnumerable<ecommerce_libro_ulp_backend.Models.Usuario>

@using ecommerce_libro_ulp_backend.Models

@{
    ViewData["Title"] = "Listado de Usuarios";
}

<div class="container mt-4 mb-5">

    <!-- Encabezado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item">
                        <a href="/">Inicio</a>
                    </li>
                    <li class="breadcrumb-item active" aria-current="page">
                        Usuarios
                    </li>
                </ol>
            </nav>

            <h2 class="fw-bold text-primary">Gestión de Usuarios</h2>
        </div>

        <div>
            <a asp-action="Crear" class="btn btn-success shadow-sm">
                <i class="bi bi-person-plus-fill"></i>
                Crear Nuevo Usuario
            </a>
        </div>
    </div>

    <!-- Filtros del servidor -->
    <div class="card shadow-sm mb-4">
        <div class="card-body bg-light rounded">

            <form asp-action="Index" method="get" class="row g-3 align-items-end">

                <div class="col-md-5">
                    <label for="busqueda" class="form-label fw-semibold">
                        Nombre o email
                    </label>

                    <input type="text"
                           id="busqueda"
                           name="busqueda"
                           value="@ViewBag.Busqueda"
                           class="form-control"
                           placeholder="Buscar por nombre o email..." />
                </div>

                <div class="col-md-3">
                    <label for="rol" class="form-label fw-semibold">
                        Rol
                    </label>

                    <select id="rol" name="rol" class="form-select">
                        <option value="">Todos</option>

                        @foreach (var item in Enum.GetValues<RolUsuario>())
                        {
                            <option value="@item"
                                    selected="@(ViewBag.Rol?.ToString() == item.ToString())">
                                @item
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label for="estado" class="form-label fw-semibold">
                        Estado
                    </label>

                    <select id="estado" name="estado" class="form-select">
                        <option value="">Todos</option>

                        @foreach (var item in Enum.GetValues<EstadoUsuario>())
                        {
                            <option value="@item"
                                    selected="@(ViewBag.Estado?.ToString() == item.ToString())">
                                @(item switch
                                {
                                    EstadoUsuario.ACTIVO => "Activo",
                                    EstadoUsuario.INACTIVO => "Inactivo",
                                    EstadoUsuario.SUSPENDIDO => "Suspendido",
                                    _ => item.ToString()
                                })
                            </option>
                        }
                    </select>
                </div>

                <div class="col-md-2 d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary w-100"
                            title="Buscar">
                        <i class="bi bi-search"></i>
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary"
                       title="Limpiar filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                </div>

            </form>
        </div>
    </div>

    <!-- Tabla de usuarios -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">

                <table class="table table-hover table-striped mb-0 align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var usuario in Model)
                            {
                                <tr>
                                    <td class="fw-semibold">
                                        @usuario.Nombre
                                    </td>

                                    <td>
                                        @usuario.Email
                                    </td>

                                    <td>
                                        <span class="badge bg-secondary">
                                            @usuario.Rol
                                        </span>
                                    </td>

                                    <td>
                                        <span class="badge @(usuario.Estado switch
                                        {
                                            EstadoUsuario.ACTIVO => "bg-success",
                                            EstadoUsuario.INACTIVO => "bg-danger",
                                            EstadoUsuario.SUSPENDIDO => "bg-warning text-dark",
                                            _ => "bg-secondary"
                                        })">
                                            @(usuario.Estado switch
                                            {
                                                EstadoUsuario.ACTIVO => "Activo",
                                                EstadoUsuario.INACTIVO => "Inactivo",
                                                EstadoUsuario.SUSPENDIDO => "Suspendido",
                                                _ => usuario.Estado.ToString()
                                            })
                                        </span>
                                    </td>

                                    <td class="text-center">
                                        <div class="btn-group" role="group">

                                            <a asp-action="Details"
                                               asp-route-id="@usuario.Id"
                                               class="btn btn-sm btn-info text-white"
                                               title="Ver detalles">
                                                <i class="bi bi-eye"></i> Ver
                                            </a>

                                            <a asp-action="Editar"
                                               asp-route-id="@usuario.Id"
                                               class="btn btn-sm btn-primary"
                                               title="Editar">
                                                <i class="bi bi-pencil-square"></i> Editar
                                            </a>

                                            <a asp-action="Eliminar"
                                               asp-route-id="@usuario.Id"
                                               class="btn btn-sm btn-danger"
                                               title="Eliminar">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </a>

                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No se encontraron usuarios que coincidan con los filtros.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>

    <!-- Paginación del servidor -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="card bg-white shadow-sm mt-4 p-3
                    d-flex flex-row flex-wrap justify-content-between
                    align-items-center gap-3">

            <span class="text-muted small">
                Página <strong>@ViewBag.CurrentPage</strong>
                de @ViewBag.TotalPages
                (@ViewBag.TotalRegistros usuarios en total)
            </span>

            <nav aria-label="Paginación de usuarios">
                <ul class="pagination pagination-sm mb-0">

                    <!-- Anterior -->
                    <li class="page-item @(ViewBag.CurrentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage - 1)"
                           asp-route-busqueda="@ViewBag.Busqueda"
                           asp-route-rol="@ViewBag.Rol"
                           asp-route-estado="@ViewBag.Estado">
                            Anterior
                        </a>
                    </li>

                    <!-- Números de página -->
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@i"
                               asp-route-busqueda="@ViewBag.Busqueda"
                               asp-route-rol="@ViewBag.Rol"
                               asp-route-estado="@ViewBag.Estado">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Siguiente -->
                    <li class="page-item @(ViewBag.CurrentPage == ViewBag.TotalPages ? "disabled" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-page="@(ViewBag.CurrentPage + 1)"
                           asp-route-busqueda="@ViewBag.Busqueda"
                           asp-route-rol="@ViewBag.Rol"
                           asp-route-estado="@ViewBag.Estado">
                            Siguiente
                        </a>
                    </li>

                </ul>
            </nav>
        </div>
    }

</div>