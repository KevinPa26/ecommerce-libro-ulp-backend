@model IEnumerable<ecommerce_libro_ulp_backend.Models.Usuario>

@{
    ViewData["Title"] = "Listado de Usuarios";
}

<div id="app" class="container mt-4">
    <!-- Nombre de la sección donde estás parado -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="/">Inicio</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Usuarios</li>
                </ol>
            </nav>
            <h2 class="fw-bold text-primary">Gestión de Usuarios</h2>
        </div>
        
        <!-- Botón de crear usuario -->
        <div>
            <a asp-action="Crear" class="btn btn-success shadow-sm">
                <i class="bi bi-person-plus-fill"></i> Crear Nuevo Usuario
            </a>
        </div>
    </div>

    <!-- Barra de búsqueda rápida -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="input-group">
                <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                <input type="text" v-model="busqueda" placeholder="Filtrar por nombre o email..." class="form-control" />
            </div>
        </div>
    </div>

    <!-- Tabla de datos -->
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Nombre</th>
                            <th>Email</th>
                            <th>Rol</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <template v-if="usuariosPaginados.length > 0">
                            <tr v-for="usuario in usuariosPaginados" :key="usuario.Id">
                                <td class="fw-semibold">{{ usuario.Nombre }}</td>
                                <td>{{ usuario.Email }}</td>
                                <td>
                                    <span class="badge bg-secondary">{{ usuario.Rol }}</span>
                                </td>
                                <td>
                                    <span :class="usuario.Estado === 0 ? 'badge bg-success' : 'badge bg-danger'">
                                        {{ usuario.Estado === 0 ? 'Activo' : 'Inactivo' }}
                                    </span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group" role="group">
                                        <!-- Botón Ver / Detalles con Bootstrap Icon -->
                                        <a :href="'/Usuarios/Details/' + usuario.Id" class="btn btn-sm btn-info text-white" title="Ver Detalles">
                                            <i class="bi bi-eye"></i> Ver
                                        </a>
                                        <!-- Botón Editar con Bootstrap Icon -->
                                        <a :href="'/Usuarios/Editar/' + usuario.Id" class="btn btn-sm btn-primary" title="Editar">
                                            <i class="bi bi-pencil-square"></i> Editar
                                        </a>
                                        <!-- Botón Eliminar con Bootstrap Icon -->
                                        <a :href="'/Usuarios/Eliminar/' + usuario.Id" class="btn btn-sm btn-danger" title="Eliminar">
                                            <i class="bi bi-trash"></i> Eliminar
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        </template>
                        <template v-else>
                            <tr>
                                <td colspan="5" class="text-center py-4 text-muted">
                                    No se encontraron usuarios registrados o coincidentes.
                                </td>
                            </tr>
                        </template>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Paginación -->
    <nav class="d-flex justify-content-between align-items-center mt-3" v-if="totalPaginas > 1">
        <div class="text-muted small">
            Mostrando página {{ currentPage }} de {{ totalPaginas }}
        </div>
        <ul class="pagination mb-0">
            <li class="page-item" :class="{ disabled: currentPage === 1 }">
                <button class="page-link" @@click="cambiarPagina(currentPage - 1)">Anterior</button>
            </li>
            
            <li class="page-item" v-for="pagina in totalPaginas" :key="pagina" :class="{ active: pagina === currentPage }">
                <button class="page-link" @@click="cambiarPagina(pagina)">{{ pagina }}</button>
            </li>

            <li class="page-item" :class="{ disabled: currentPage === totalPaginas }">
                <button class="page-link" @@click="cambiarPagina(currentPage + 1)">Siguiente</button>
            </li>
        </ul>
    </nav>
</div>

<!-- Script de Vue 3 (Options API) -->
<script>
    const { createApp } = Vue;

    createApp({
        data() {
            return {
                // Pasamos la lista de C# (Razor) a un arreglo de JavaScript seguro
                usuarios: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model)),
                busqueda: '',
                currentPage: 1,
                pageSize: 5 // Cantidad de filas por página
            }
        },
        computed: {
            // Filtra los usuarios en tiempo real según el buscador
            usuariosFiltrados() {
                if (!this.busqueda) return this.usuarios;
                return this.usuarios.filter(u => 
                    u.nombre.toLowerCase().includes(this.busqueda.toLowerCase()) ||
                    u.email.toLowerCase().includes(this.busqueda.toLowerCase())
                );
            },
            // Calcula el total de páginas según los elementos filtrados
            totalPaginas() {
                return Math.ceil(this.usuariosFiltrados.length / this.pageSize) || 1;
            },
            // Corta el arreglo para mostrar solo los elementos de la página actual
            usuariosPaginados() {
                const inicio = (this.currentPage - 1) * this.pageSize;
                const fin = inicio + this.pageSize;
                return this.usuariosFiltrados.slice(inicio, fin);
            }
        },
        methods: {
            // Cambia de página de forma controlada
            cambiarPagina(pagina) {
                if (pagina >= 1 && pagina <= this.totalPaginas) {
                    this.currentPage = pagina;
                }
            }
        },
        watch: {
            // Si el usuario escribe algo en el buscador, lo devolvemos automáticamente a la página 1
            busqueda() {
                this.currentPage = 1;
            }
        }
    }).mount('#app');
</script>