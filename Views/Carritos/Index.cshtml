@using System.Diagnostics.Eventing.Reader
@model IEnumerable<ecommerce_libro_ulp_backend.Models.Carrito>

@{
	ViewData["Title"] = "Mi carrito";
	var carritos = Model?.ToList() ?? new List<ecommerce_libro_ulp_backend.Models.Carrito>();
}

<div id="app" class="container py-4">
	@Html.AntiForgeryToken()
	<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
		<div>
			<h1 class="h2 mb-1">Mi carrito</h1>
			<p class="text-muted mb-0">Libros que quieres comprar.</p>
		</div>
		<span class="badge rounded-pill text-bg-secondary">@carritos.Sum(carrito => carrito.Cantidad) unidades</span>
	</div>

	@if (carritos.Count == 0)
	{
		<div class="border rounded p-4 p-md-5 text-center">
			<i class="bi bi-basket3 text-primary fs-1" aria-hidden="true"></i>
			<h2 class="h5 mt-3">Tu carrito está vacío</h2>
			<p class="text-muted mb-0">Los libros que agregues aparecerán aquí.</p>
		</div>
	}
	else
	{
		<div class="table-responsive border rounded">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th scope="col">Libro</th>
						<th scope="col">Agregado</th>
						<th scope="col">Cantidad</th>
						<th scope="col" class="text-end">Acciones</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var carrito in carritos)
					{
						@if (carrito.Libro != null)
						{
							<tr>
								<td class="fw-semibold">@carrito.Libro.Titulo</td>
								<td>
									@if (carrito.FechaAgregado.HasValue)
									{
										@carrito.FechaAgregado.Value.ToString("dd/MM/yyyy")
									}
									else
									{
										<span class="text-muted">Sin fecha</span>
									}
								</td>
								<td>
									<label class="visually-hidden" for="cantidad-@carrito.Id">Cantidad del libro @carrito.Libro.Titulo</label>
									<input id="cantidad-@carrito.Id" class="form-control form-control-sm" type="number" min="1" value="@carrito.Cantidad" style="width: 6rem" />
								</td>
								<td class="text-end">
									<button type="button" class="btn btn-sm btn-outline-danger" aria-label="Quitar @carrito.Libro.Titulo del carrito" v-on:click="quitar(@carrito.Id)">
										<i class="bi bi-trash3 me-1" aria-hidden="true"></i>Quitar
									</button>
								</td>
							</tr>
						} 
						else
						{
							<tr>
								<td class="fw-semibold">LIBRO @carrito.LibroId NO ENCONTRADO</td>
								<td>
									@if (carrito.FechaAgregado.HasValue)
									{
										@carrito.FechaAgregado.Value.ToString("dd/MM/yyyy")
									}
									else
									{
										<span class="text-muted">Sin fecha</span>
									}
								</td>
								<td class="text-end">
									<button type="button" class="btn btn-sm btn-outline-danger" aria-label="Quitar Libro @carrito.LibroId del carrito" v-on:click="quitar(@carrito.Id)">
										<i class="bi bi-trash3 me-1" aria-hidden="true"></i>Quitar
									</button>
								</td>
							</tr>
						}
					}
				</tbody>
			</table>
		</div>

		<div class="d-flex justify-content-end mt-4">
			<button type="button" class="btn btn-primary">
				<i class="bi bi-bag-check me-1" aria-hidden="true"></i>Comprar
			</button>
		</div>
	}
</div>

<!-- Script de Vue 3 (Options API) -->
<script>
	Vue.createApp({
		methods: {
			async quitar(carritoId) {
				const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
				const form = new URLSearchParams();
				form.append("id", carritoId);
				if (tokenInput) form.append("__RequestVerificationToken", tokenInput.value);

				try {
					const response = await fetch("@Url.Action("Eliminar", "Carritos")", {
						method: "POST",
						credentials: "same-origin",
					headers: {
							"Accept": "text/html"
					},
					body: form
					});

					if (response.ok) {
						window.location.reload();
					} else {
						throw new Error(`Error ${response.status}`);
					}
				} catch (error) {
					console.error(error);
					alert("No se pudo quitar del carrito: " + error.message);
				}
			}
		}
	}).mount('#app')
</script>