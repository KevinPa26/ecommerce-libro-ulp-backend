@using System.Diagnostics.Eventing.Reader
@model IEnumerable<ecommerce_libro_ulp_backend.Models.Carrito>

@{
    ViewData["Title"] = "Mi carrito";
    var carritos = Model?.ToList() ?? new List<ecommerce_libro_ulp_backend.Models.Carrito>();
}

<div id="app" class="container py-4">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Mi carrito</h1>
			<div class="mb-4">
				<label for="busquedaLibros" class="form-label fw-semibold">
					Buscar libros en mi carrito
				</label>

				<input
					id="busquedaLibros"
					type="search"
					class="form-control"
					placeholder="Escribí el título del libro..."
					v-model="busqueda"
					@@input="buscar"
					autocomplete="off" />

				<small class="text-muted">
					Los resultados se actualizan automáticamente mientras escribís.
				</small>
			</div>
            <p class="text-muted mb-0">Libros que quieres comprar.</p>
        </div>
        <span class="badge rounded-pill text-bg-secondary">@carritos.Sum(carrito => carrito.Cantidad) unidades</span>
    </div>

    <div v-if="carritos.length === 0" class="border rounded p-4 p-md-5 text-center">
		<i class="bi bi-basket3 text-primary fs-1" aria-hidden="true"></i>

		<h2 class="h5 mt-3">
			{{ busqueda ? 'No se encontraron libros' : 'Tu carrito está vacío' }}
		</h2>

		<p class="text-muted mb-0">
			{{ busqueda
				? 'No hay libros que coincidan con tu búsqueda.'
				: 'Los libros que agregues aparecerán aquí.' }}
		</p>
	</div>

	<div v-else>
		<div class="table-responsive border rounded">
			<table class="table table-hover align-middle mb-0">
				<thead class="table-light">
					<tr>
						<th scope="col">Libro</th>
						<th scope="col">Agregado</th>
						<th scope="col">Cantidad</th>
						<th scope="col" class="text-end">Acciones</th>
					</tr>
				</thead>

				<tbody>
					<tr v-for="carrito in carritos" :key="carrito.id">
						<td class="fw-semibold">{{ carrito.titulo }}</td>

						<td>
							{{ carrito.fechaAgregado || 'Sin fecha' }}
						</td>

						<td>
							<input
								:id="'cantidad-' + carrito.id"
								class="form-control form-control-sm"
								type="number"
								min="1"
								:value="carrito.cantidad"
								style="width: 6rem" />
						</td>

						<td class="text-end">
							<button
								type="button"
								class="btn btn-sm btn-outline-danger"
								:aria-label="'Quitar ' + carrito.titulo + ' del carrito'"
								@@click="quitar(carrito.id, carrito.titulo)">

								<i class="bi bi-trash3 me-1" aria-hidden="true"></i>
								Quitar
							</button>
						</td>
					</tr>
				</tbody>
			</table>
		</div>

		<div class="d-flex justify-content-end mt-4">
			<button
				type="button"
				class="btn btn-primary"
				@@click="comprar"
				:disabled="procesando">

				<i class="bi bi-bag-check me-1" aria-hidden="true"></i>

				{{ procesando ? 'Procesando compra...' : 'Comprar' }}
			</button>
		</div>
	</div>
</div>

<!-- Script de Vue 3 (Options API) -->
<script>
    Vue.createApp({
        data() {
			const carritosIniciales = @Html.Raw(
				System.Text.Json.JsonSerializer.Serialize(
					carritos
						.Where(c => c.Libro != null)
						.Select(c => new
						{
							id = c.Id,
							libroId = c.LibroId,
							titulo = c.Libro!.Titulo,
							cantidad = c.Cantidad,
							fechaAgregado = c.FechaAgregado?.ToString("dd/MM/yyyy")
						})
				)
			);

			return {
				procesando: false,
				busqueda: '',
				carritos: carritosIniciales,
				carritosCompra: carritosIniciales,
				temporizadorBusqueda: null,
				ultimaBusqueda: 0
			};
		},
        methods: {
			buscar() {
				clearTimeout(this.temporizadorBusqueda);

				this.temporizadorBusqueda = setTimeout(() => {
					this.ejecutarBusqueda();
				}, 300);
			},

			async ejecutarBusqueda() {
				const solicitud = ++this.ultimaBusqueda;

				try {
					const url = new URL(
						'@Url.Action("Buscar", "Carritos")',
						window.location.origin
					);

					url.searchParams.set('titulo', this.busqueda.trim());

					const response = await fetch(url, {
						method: 'GET',
						credentials: 'same-origin',
						headers: {
							'Accept': 'application/json'
						}
					});

					if (!response.ok) {
						throw new Error(`Error ${response.status}`);
					}

					const resultados = await response.json();

					// Evita que una búsqueda anterior reemplace resultados más recientes.
					if (solicitud !== this.ultimaBusqueda) return;

					this.carritos = resultados;

				} catch (error) {
					console.error('Error al buscar libros:', error);

					window.alerta.error(
						'Error',
						'No se pudieron buscar los libros del carrito.'
					);
				}
			},
            async quitar(carritoId, tituloLibro) {
                const confirmado = await window.alerta.confirmar(
                    '¿Quitar del carrito?',
                    `¿Estás seguro de que deseas eliminar "${tituloLibro}" de tu carrito?`,
                    'Sí, quitar'
                );

                if (!confirmado) return;

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const form = new URLSearchParams();
                form.append("id", carritoId);
                if (tokenInput) form.append("__RequestVerificationToken", tokenInput.value);

                try {
                    const response = await fetch("@Url.Action("Eliminar", "Carritos")", {
                        method: "POST",
                        credentials: "same-origin",
                        headers: {
                            "Accept": "text/html"
                        },
                        body: form
                    });

                    if (response.ok) {
                        window.alerta.toast('El libro ha sido eliminado de tu carrito.', 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        throw new Error(`Error ${response.status}`);
                    }
                } catch (error) {
                    console.error(error);
                    window.alerta.error('Atención', "No se pudo quitar del carrito: " + error.message);
                }
            },
            async comprar() {
                const detalles = this.carritosCompra.map(carrito => ({
                    LibroId: carrito.LibroId,
                    Cantidad: carrito.Cantidad
                }));

                if (!detalles.length) {
                    window.alerta.error('Carrito vacío', 'Tu carrito está vacío.');
                    return;
                }

                const confirmado = await window.alerta.confirmar(
                    '¿Confirmar compra?',
                    `¿Estás seguro de que deseas procesar la compra de los ${detalles.length} ítem(s) de tu carrito?`,
                    'Sí, comprar'
                );

                if (!confirmado) return;

                this.procesando = true;

                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenElement ? tokenElement.value : '';

                try {
                    const response = await fetch('/Compras/Crear', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(detalles)
                    });

                    if (response.redirected) {
                        window.location.href = response.url;
                    } else if (response.ok) {
                        await window.alerta.exito('¡Compra Exitosa!', 'Tu pedido se ha procesado correctamente.');
                        window.location.href = '/Compras/Index';
                    } else {
                        const errorTexto = await response.text();
                        window.alerta.error('Error', 'No se pudo procesar la compra: ' + errorTexto);
                        this.procesando = false;
                    }
                } catch (error) {
                    console.error('Error de red:', error);
                    window.alerta.error('Error de red', 'Ocurrió un error al conectar con el servidor.');
                    this.procesando = false;
                }
            }
        }
    }).mount('#app')
</script>