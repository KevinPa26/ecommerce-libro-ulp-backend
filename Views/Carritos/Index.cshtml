@using System.Diagnostics.Eventing.Reader
@model IEnumerable<ecommerce_libro_ulp_backend.Models.Carrito>

@{
    ViewData["Title"] = "Mi carrito";
    var carritos = Model?.ToList() ?? new List<ecommerce_libro_ulp_backend.Models.Carrito>();
}

<div id="app" class="container py-4">
    @Html.AntiForgeryToken()
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <h1 class="h2 mb-1">Mi carrito</h1>
            <p class="text-muted mb-0">Libros que quieres comprar.</p>
        </div>
        <span class="badge rounded-pill text-bg-secondary">@carritos.Sum(carrito => carrito.Cantidad) unidades</span>
    </div>

    @if (carritos.Count == 0)
    {
        <div class="border rounded p-4 p-md-5 text-center">
            <i class="bi bi-basket3 text-primary fs-1" aria-hidden="true"></i>
            <h2 class="h5 mt-3">Tu carrito está vacío</h2>
            <p class="text-muted mb-0">Los libros que agregues aparecerán aquí.</p>
        </div>
    }
    else
    {
        <div class="table-responsive border rounded">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th scope="col">Libro</th>
                        <th scope="col">Agregado</th>
                        <th scope="col">Cantidad</th>
                        <th scope="col" class="text-end">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var carrito in carritos)
                    {
                        @if (carrito.Libro != null)
                        {
                            <tr>
                                <td class="fw-semibold">@carrito.Libro.Titulo</td>
                                <td>
                                    @if (carrito.FechaAgregado.HasValue)
                                    {
                                        @carrito.FechaAgregado.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin fecha</span>
                                    }
                                </td>
                                <td>
                                    <label class="visually-hidden" for="cantidad-@carrito.Id">Cantidad del libro @carrito.Libro.Titulo</label>
                                    <input id="cantidad-@carrito.Id" class="form-control form-control-sm" type="number" min="1" value="@carrito.Cantidad" style="width: 6rem" />
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Quitar @carrito.Libro.Titulo del carrito" @@click="quitar(@carrito.Id, '@carrito.Libro.Titulo')">
                                        <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Quitar
                                    </button>
                                </td>
                            </tr>
                        } 
                        else
                        {
                            <tr>
                                <td class="fw-semibold text-danger">LIBRO @carrito.LibroId NO ENCONTRADO</td>
                                <td>
                                    @if (carrito.FechaAgregado.HasValue)
                                    {
                                        @carrito.FechaAgregado.Value.ToString("dd/MM/yyyy")
                                    }
                                    else
                                    {
                                        <span class="text-muted">Sin fecha</span>
                                    }
                                </td>
                                <td>-</td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-danger" aria-label="Quitar Libro @carrito.LibroId del carrito" @@click="quitar(@carrito.Id, 'Libro no disponible')">
                                        <i class="bi bi-trash3 me-1" aria-hidden="true"></i>Quitar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="d-flex justify-content-end mt-4">
            <button type="button" class="btn btn-primary" @@click="comprar" :disabled="procesando">
                <i class="bi bi-bag-check me-1" aria-hidden="true"></i>
                {{ procesando ? 'Procesando compra...' : 'Comprar' }}
            </button>
        </div>
    }
</div>

<!-- Script de Vue 3 (Options API) -->
<script>
    Vue.createApp({
        data() {
            return {
                procesando: false,
                carritos: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(carritos))
            };
        },
        methods: {
            async quitar(carritoId, tituloLibro) {
                const confirmado = await window.alerta.confirmar(
                    '¿Quitar del carrito?',
                    `¿Estás seguro de que deseas eliminar "${tituloLibro}" de tu carrito?`,
                    'Sí, quitar'
                );

                if (!confirmado) return;

                const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                const form = new URLSearchParams();
                form.append("id", carritoId);
                if (tokenInput) form.append("__RequestVerificationToken", tokenInput.value);

                try {
                    const response = await fetch("@Url.Action("Eliminar", "Carritos")", {
                        method: "POST",
                        credentials: "same-origin",
                        headers: {
                            "Accept": "text/html"
                        },
                        body: form
                    });

                    if (response.ok) {
                        window.alerta.toast('El libro ha sido eliminado de tu carrito.', 'success');
                        setTimeout(() => {
                            window.location.reload();
                        }, 1000);
                    } else {
                        throw new Error(`Error ${response.status}`);
                    }
                } catch (error) {
                    console.error(error);
                    window.alerta.error('Atención', "No se pudo quitar del carrito: " + error.message);
                }
            },
            async comprar() {
                const detalles = this.carritos.map(carrito => ({
                    LibroId: carrito.LibroId,
                    Cantidad: carrito.Cantidad
                }));

                if (!detalles.length) {
                    window.alerta.error('Carrito vacío', 'Tu carrito está vacío.');
                    return;
                }

                const confirmado = await window.alerta.confirmar(
                    '¿Confirmar compra?',
                    `¿Estás seguro de que deseas procesar la compra de los ${detalles.length} ítem(s) de tu carrito?`,
                    'Sí, comprar'
                );

                if (!confirmado) return;

                this.procesando = true;

                const tokenElement = document.querySelector('input[name="__RequestVerificationToken"]');
                const token = tokenElement ? tokenElement.value : '';

                try {
                    const response = await fetch('/Compras/Crear', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': token
                        },
                        body: JSON.stringify(detalles)
                    });

                    if (response.redirected) {
                        window.location.href = response.url;
                    } else if (response.ok) {
                        await window.alerta.exito('¡Compra Exitosa!', 'Tu pedido se ha procesado correctamente.');
                        window.location.href = '/Compras/Index';
                    } else {
                        const errorTexto = await response.text();
                        window.alerta.error('Error', 'No se pudo procesar la compra: ' + errorTexto);
                        this.procesando = false;
                    }
                } catch (error) {
                    console.error('Error de red:', error);
                    window.alerta.error('Error de red', 'Ocurrió un error al conectar con el servidor.');
                    this.procesando = false;
                }
            }
        }
    }).mount('#app')
</script>