
@{
    ViewData["Title"] = "Inicio";
}

<style>
    .home-page {
        --ink: #20231f;
        --muted: #77796f;
        --paper: #f8f7f2;
        --accent: #b6d7a8;
        background: var(--paper);
        color: var(--ink);
        overflow: hidden;
    }

    .home-page .container {
        max-width: 1240px;
    }

    .hero-section {
        position: relative;
        overflow: hidden;
        min-height: 510px;
        display: flex;
        align-items: center;
        background: #202c28;
        border-radius: 24px;
        color: white;
        isolation: isolate;
    }

    .hero-section::before {
        content: "";
        position: absolute;
        width: 540px;
        height: 540px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(182,215,168,.22), transparent 70%);
        top: -180px;
        right: 5%;
        z-index: -1;
    }

    .hero-section::after {
        content: "";
        position: absolute;
        width: 400px;
        height: 400px;
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 50%;
        right: -100px;
        bottom: -230px;
        z-index: -1;
    }

    .hero-content {
        position: relative;
        z-index: 2;
        padding: 70px 65px;
    }

    .hero-eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        color: var(--accent);
        font-size: .76rem;
        font-weight: 700;
        letter-spacing: 2px;
        text-transform: uppercase;
        margin-bottom: 24px;
    }

    .hero-eyebrow::before {
        content: "";
        width: 24px;
        height: 1px;
        background: var(--accent);
    }

    .hero-title {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: clamp(2.8rem, 5vw, 4.7rem);
        line-height: 1.06;
        letter-spacing: -2px;
        max-width: 650px;
        margin-bottom: 24px;
    }

    .hero-title span {
        color: var(--accent);
        font-style: italic;
    }

    .hero-description {
        color: rgba(255,255,255,.68);
        font-size: 1.05rem;
        line-height: 1.8;
        max-width: 480px;
        margin-bottom: 34px;
    }

    .btn-explore {
        display: inline-flex;
        align-items: center;
        gap: 13px;
        background: var(--accent);
        color: #202c28;
        padding: 15px 23px;
        border-radius: 8px;
        font-weight: 700;
        text-decoration: none;
        transition: all .25s ease;
    }

    .btn-explore:hover {
        background: #d0e7c5;
        color: #202c28;
        transform: translateY(-3px);
    }

    .hero-visual {
        position: absolute;
        right: 7%;
        top: 50%;
        transform: translateY(-50%);
        width: 340px;
        height: 380px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .book-stack {
        position: relative;
        width: 260px;
        height: 310px;
        transform: rotate(-7deg);
    }

    .book {
        position: absolute;
        border-radius: 5px 13px 13px 5px;
        box-shadow: 14px 22px 35px rgba(0,0,0,.3);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        padding: 22px;
        overflow: hidden;
    }

    .book::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: 10px;
        width: 2px;
        background: rgba(255,255,255,.18);
    }

    .book-one {
        width: 190px;
        height: 275px;
        background: #bd805f;
        color: #fff5e9;
        left: 12px;
        top: 15px;
        transform: rotate(-13deg);
    }

    .book-two {
        width: 190px;
        height: 275px;
        background: #d5d4ae;
        color: #394a3c;
        left: 75px;
        top: 30px;
        transform: rotate(10deg);
    }

    .book-three {
        width: 190px;
        height: 275px;
        background: #627c70;
        color: #f2f2e6;
        left: 45px;
        top: 0;
        transform: rotate(-2deg);
        z-index: 2;
    }

    .book-small {
        font-size: .55rem;
        letter-spacing: 2px;
        text-transform: uppercase;
        opacity: .8;
    }

    .book-name {
        font-family: Georgia, serif;
        font-size: 1.7rem;
        line-height: 1.05;
    }

    .book-bottom {
        font-size: .62rem;
        letter-spacing: 1px;
    }

    .floating-note {
        position: absolute;
        right: -12px;
        bottom: 5px;
        background: #f8f7f2;
        color: #20231f;
        padding: 15px 19px;
        border-radius: 12px;
        box-shadow: 0 15px 35px rgba(0,0,0,.2);
        transform: rotate(3deg);
        z-index: 3;
    }

    .floating-note strong {
        display: block;
        font-family: Georgia, serif;
        font-size: 1.25rem;
    }

    .floating-note small {
        color: #77796f;
        font-size: .72rem;
    }

    .section-heading {
        display: flex;
        align-items: end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 30px;
    }

    .section-kicker {
        color: #849c76;
        text-transform: uppercase;
        font-weight: 700;
        font-size: .72rem;
        letter-spacing: 2px;
        margin-bottom: 10px;
    }

    .section-title {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: 2.2rem;
        letter-spacing: -1px;
        margin: 0;
    }

    .section-link {
        color: #526b50;
        font-weight: 700;
        text-decoration: none;
        border-bottom: 1px solid #a9bda1;
        padding-bottom: 4px;
    }

    .section-link:hover {
        color: #263e2d;
    }

    .category-card {
        position: relative;
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        min-height: 190px;
        padding: 25px;
        background: #eeeee5;
        border-radius: 15px;
        text-decoration: none;
        color: var(--ink);
        transition: all .25s ease;
        overflow: hidden;
        height: 100%;
    }

    .category-card:hover {
        transform: translateY(-6px);
        background: #e5e9dc;
        color: var(--ink);
        box-shadow: 0 15px 30px rgba(40,50,35,.08);
    }

    .category-icon {
        font-size: 2rem;
        color: #72876b;
    }

    .category-card h3 {
        font-family: Georgia, serif;
        font-size: 1.5rem;
        margin-bottom: 5px;
    }

    .category-card p {
        color: var(--muted);
        font-size: .84rem;
        margin: 0;
    }

    .category-arrow {
        position: absolute;
        right: 23px;
        bottom: 24px;
        font-size: 1.3rem;
        color: #82967a;
        transition: transform .25s ease;
    }

    .category-card:hover .category-arrow {
        transform: translateX(5px);
    }

    .benefits-section {
        background: #e9ece3;
        border-radius: 20px;
        padding: 35px;
    }

    .benefit-item {
        display: flex;
        gap: 15px;
        align-items: center;
    }

    .benefit-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: grid;
        place-items: center;
        background: #d6e0ce;
        border-radius: 13px;
        color: #405d43;
        font-size: 1.25rem;
    }

    .benefit-item h4 {
        font-size: .95rem;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .benefit-item p {
        color: #77796f;
        font-size: .8rem;
        margin: 0;
    }

    .closing-section {
        text-align: center;
        padding: 75px 20px 85px;
    }

    .closing-section h2 {
        font-family: Georgia, 'Times New Roman', serif;
        font-size: clamp(2rem, 4vw, 3.2rem);
        letter-spacing: -1px;
        margin-bottom: 15px;
    }

    .closing-section p {
        color: var(--muted);
        margin-bottom: 27px;
    }

    @@media (max-width: 991px) {
        .hero-visual {
            opacity: .23;
            right: -25px;
        }

        .hero-content {
            padding: 65px 40px;
        }
    }

    @@media (max-width: 575px) {
        .hero-section {
            min-height: 470px;
            border-radius: 16px;
        }

        .hero-content {
            padding: 45px 25px;
        }

        .hero-title {
            font-size: 2.8rem;
        }

        .hero-description {
            font-size: .95rem;
        }

        .hero-visual {
            right: -100px;
            opacity: .13;
        }

        .section-heading {
            align-items: start;
            flex-direction: column;
        }

        .benefits-section {
            padding: 25px 20px;
        }
    }
</style>

<div class="home-page py-4 py-lg-5">
    <div class="container">

        <!-- HERO -->
        <section class="hero-section mb-5">
            <div class="hero-content">
                <div class="hero-eyebrow">
                    Un mundo entre páginas
                </div>

                <h1 class="hero-title">
                    Algunas historias cambian
                    <span>todo.</span>
                </h1>

                <p class="hero-description">
                    Descubrí libros que inspiran, conocimientos que transforman
                    y nuevas historias esperando ser parte de la tuya.
                    Tu próxima lectura comienza acá.
                </p>

                <a asp-controller="Libros"
                   asp-action="Index"
                   class="btn-explore">
                    Explorar biblioteca
                    <span aria-hidden="true">→</span>
                </a>
            </div>

            <div class="hero-visual" aria-hidden="true">
                <div class="book-stack">
                    <div class="book book-one">
                        <span class="book-small">Colección · 01</span>
                        <span class="book-name">El arte de descubrir</span>
                        <span class="book-bottom">EDICIÓN ESPECIAL</span>
                    </div>

                    <div class="book book-two">
                        <span class="book-small">Colección · 02</span>
                        <span class="book-name">Nuevos horizontes</span>
                        <span class="book-bottom">CULTURA & IDEAS</span>
                    </div>

                    <div class="book book-three">
                        <span class="book-small">Colección · 03</span>
                        <span class="book-name">Donde nacen las ideas</span>
                        <span class="book-bottom">LECTURAS INFINITAS</span>
                    </div>
                </div>

                <div class="floating-note">
                    <strong>Tu próxima historia</strong>
                    <small>Está a una página de distancia.</small>
                </div>
            </div>
        </section>

        <!-- CATEGORÍAS -->
        <section class="mb-5 pb-3">
            <div class="section-heading">
                <div>
                    <div class="section-kicker">Explorá a tu manera</div>
                    <h2 class="section-title">Un libro para cada mundo.</h2>
                </div>

                <a asp-controller="Libros"
                   asp-action="Index"
                   class="section-link">
                    Ver biblioteca →
                </a>
            </div>

            <div class="row g-3">
                <div class="col-12 col-md-6 col-lg-3">
                    <a asp-controller="Libros" asp-action="Index"
                       class="category-card">
                        <div class="category-icon">⌘</div>
                        <div>
                            <h3>Tecnología</h3>
                            <p>Ideas, innovación y futuro.</p>
                        </div>
                        <span class="category-arrow">↗</span>
                    </a>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <a asp-controller="Libros" asp-action="Index"
                       class="category-card">
                        <div class="category-icon">⌂</div>
                        <div>
                            <h3>Hogar</h3>
                            <p>Inspiración para todos los días.</p>
                        </div>
                        <span class="category-arrow">↗</span>
                    </a>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <a asp-controller="Libros" asp-action="Index"
                       class="category-card">
                        <div class="category-icon">✳</div>
                        <div>
                            <h3>Indumentaria</h3>
                            <p>Estilo, creatividad y expresión.</p>
                        </div>
                        <span class="category-arrow">↗</span>
                    </a>
                </div>

                <div class="col-12 col-md-6 col-lg-3">
                    <a asp-controller="Libros" asp-action="Index"
                       class="category-card">
                        <div class="category-icon">◎</div>
                        <div>
                            <h3>Otros mundos</h3>
                            <p>Siempre hay algo nuevo por descubrir.</p>
                        </div>
                        <span class="category-arrow">↗</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- BENEFICIOS -->
        <section class="benefits-section mb-5">
            <div class="row g-4">
                <div class="col-12 col-md-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">✦</div>
                        <div>
                            <h4>Descubrí algo nuevo</h4>
                            <p>Explorá una biblioteca en constante crecimiento.</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">♡</div>
                        <div>
                            <h4>Guardá tus favoritos</h4>
                            <p>Creá tu propia colección de lecturas.</p>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-md-4">
                    <div class="benefit-item">
                        <div class="benefit-icon">⌁</div>
                        <div>
                            <h4>Una experiencia simple</h4>
                            <p>Encontrá y gestioná tus libros fácilmente.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- CIERRE -->
        <section class="closing-section">
            <div class="section-kicker">El próximo capítulo es tuyo</div>

            <h2>¿Qué vas a leer hoy?</h2>

            <p>
                Explorá nuestra biblioteca y encontrá esa lectura que todavía no sabías que necesitabas.
            </p>

            <a asp-controller="Libros"
               asp-action="Index"
               class="btn-explore">
                Descubrir libros
                <span aria-hidden="true">→</span>
            </a>
        </section>

    </div>
</div>
