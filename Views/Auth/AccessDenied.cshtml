
@{
    ViewData["Title"] = "Acceso denegado";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Acceso denegado - Ecommerce Libro</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css" />

    <style>
        * { box-sizing: border-box; }

        body {
            min-height: 100vh;
            margin: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            color: #e5e7eb;
            background:
                radial-gradient(ellipse at 50% 35%, rgba(120, 55, 95, .16), transparent 48%),
                radial-gradient(ellipse at 80% 80%, rgba(40, 100, 180, .10), transparent 40%),
                #10121b;
            font-family: system-ui, sans-serif;
        }

        .denied-card {
            width: 100%;
            max-width: 650px;
            padding: 48px 32px;
            text-align: center;
            border: 1px solid rgba(255, 80, 120, .22);
            border-radius: 24px;
            background: rgba(24, 27, 40, .82);
            box-shadow: 0 25px 90px rgba(0, 0, 0, .4),
                        0 0 35px rgba(255, 55, 100, .07);
            backdrop-filter: blur(14px);
        }

        .illustration {
            width: min(100%, 300px);
            margin: 0 auto 22px;
            filter: drop-shadow(0 0 14px rgba(255, 65, 110, .35));
        }

        .error-code {
            color: #ff6688;
            font-size: clamp(3.5rem, 12vw, 5.5rem);
            font-weight: 850;
            line-height: 1;
            letter-spacing: -5px;
            text-shadow: 0 0 18px rgba(255, 65, 110, .45);
        }

        .denied-card h1 {
            margin: 18px 0 12px;
            font-size: clamp(1.5rem, 5vw, 2rem);
            font-weight: 750;
        }

        .denied-card p {
            max-width: 450px;
            margin: 0 auto;
            color: #9ca3b5;
            line-height: 1.7;
        }

        .btn-home {
            margin-top: 28px;
            padding: 11px 22px;
            color: #fff;
            font-weight: 650;
            border: 1px solid rgba(139, 156, 255, .5);
            border-radius: 10px;
            background: linear-gradient(110deg, #5968d8, #7655b9);
            box-shadow: 0 0 20px rgba(110, 105, 240, .18);
            transition: .2s ease;
        }

        .btn-home:hover {
            color: #fff;
            transform: translateY(-2px);
            box-shadow: 0 0 25px rgba(139, 156, 255, .35);
        }

        .back-link {
            display: inline-block;
            margin-top: 18px;
            color: #929bb1;
            font-size: .9rem;
            text-decoration: none;
        }

        .back-link:hover { color: #fff; }
    </style>
</head>
<body>
    <main class="denied-card">
        <svg class="illustration" viewBox="0 0 320 230"
             xmlns="http://www.w3.org/2000/svg" role="img"
             aria-label="Ilustración de acceso bloqueado">
            <defs>
                <filter id="glow">
                    <feGaussianBlur stdDeviation="5" result="blur"/>
                    <feMerge>
                        <feMergeNode in="blur"/>
                        <feMergeNode in="SourceGraphic"/>
                    </feMerge>
                </filter>
            </defs>

            <g fill="none" stroke="#ff547d" stroke-width="3"
               stroke-linecap="round" stroke-linejoin="round"
               filter="url(#glow)">
                <path d="M105 94V72a55 55 0 0 1 110 0v22"/>
                <rect x="75" y="92" width="170" height="112" rx="17"/>
                <circle cx="160" cy="139" r="13"/>
                <path d="M160 152v20"/>
                <path d="M48 65l-17-10M272 65l17-10M160 25V8"/>
                <path d="M63 179l-16 8M257 179l16 8"/>
            </g>

            <g fill="none" stroke="#7c8cff" stroke-width="2"
               opacity=".8">
                <path d="M25 112h28M267 112h28"/>
                <path d="M42 125l-12 12M278 125l12 12"/>
                <circle cx="160" cy="148" r="76"
                        stroke-dasharray="4 10"/>
            </g>

            <path d="M148 136h24" stroke="#ff547d"
                  stroke-width="3" stroke-linecap="round"/>
        </svg>

        <div class="error-code">403</div>
        <h1>No tenés permiso para entrar</h1>

        <p>
            Esta sección está protegida y tu cuenta no tiene los permisos
            necesarios para acceder. Si creés que se trata de un error,
            contactá con el administrador.
        </p>

        <a asp-controller="Home" asp-action="Index"
           class="btn btn-home">
            <i class="bi bi-house-door me-2"></i>
            Volver al inicio
        </a>

        <div>
            <a href="javascript:history.back()" class="back-link">
                <i class="bi bi-arrow-left me-1"></i>
                Volver a la página anterior
            </a>
        </div>
    </main>
</body>
</html>
